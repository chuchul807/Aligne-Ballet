{
  "sourceLanguage": "en",
  "strings": {
    "region.supporting-leg": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Supporting leg"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "支撑腿"
          }
        }
      }
    },
    "region.working-leg": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Working leg"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动作腿"
          }
        }
      }
    },
    "region.pelvis": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pelvis"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "骨盆"
          }
        }
      }
    },
    "region.torso": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Torso"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "躯干"
          }
        }
      }
    },
    "region.shoulders-arms": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Shoulders and arms"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "肩膀与手臂"
          }
        }
      }
    },
    "region.head": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Head"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "头部"
          }
        }
      }
    },
    "region.feet": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Feet"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "双脚"
          }
        }
      }
    },
    "analysis.error.detection": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pose detection failed. Please try another photo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "动作检测失败，请尝试另一张照片。"
          }
        }
      }
    },
    "analysis.error.model-unavailable": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The on-device pose model is unavailable. Reinstall the app or try again."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "本机动作模型不可用，请重新安装应用或稍后重试。"
          }
        }
      }
    },
    "analysis.error.rendering": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Could not draw the result. Please try another photo."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法绘制分析结果，请尝试另一张照片。"
          }
        }
      }
    },
    "check.failure": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysis could not finish"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "分析未能完成"
          }
        }
      }
    },
    "check.loading": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Analysing your photo…"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在分析照片…"
          }
        }
      }
    },
    "check.retake": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Please retake this photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请重新拍摄这张照片"
          }
        }
      }
    },
    "check.retry": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Choose another photo"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "选择另一张照片"
          }
        }
      }
    },
    "check.title": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Checking your pose"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "正在检查动作"
          }
        }
      }
    },
    "common.ok": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "OK"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "好"
          }
        }
      }
    },
    "common.settings": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open Settings"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "打开设置"
          }
        }
      }
    },
    "feedback.a-la-seconde-foot-not-pointed.high": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lengthen through your ankle and point your working toes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "伸展脚踝，绷长脚尖。"
          }
        }
      }
    },
    "feedback.a-la-seconde-foot-not-pointed.medium": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your working foot may be shortening the leg line; lengthen through the toes."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "伸展脚踝，绷长脚尖（根据当前照片判断）。"
          }
        }
      }
    },
    "feedback.a-la-seconde-pelvis-out-of-line.high": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your pelvis closer to level while keeping the working leg long."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持动作腿伸长，同时让骨盆更接近水平。"
          }
        }
      }
    },
    "feedback.a-la-seconde-pelvis-out-of-line.medium": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pelvic line may be lifting more than the leg height requires."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持动作腿伸长，同时让骨盆更接近水平（根据当前照片判断）。"
          }
        }
      }
    },
    "feedback.a-la-seconde-turnout-not-visible.high": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Rotate your working leg outward until the heel is slightly visible."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在舒适范围内向外转动动作腿，让脚跟线条稍微可见。"
          }
        }
      }
    },
    "feedback.a-la-seconde-turnout-not-visible.medium": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The working heel line is unclear; show a little more heel if comfortable."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在舒适范围内向外转动动作腿，让脚跟线条稍微可见（根据当前照片判断）。"
          }
        }
      }
    },
    "feedback.a-la-seconde-working-knee-bent.high": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lengthen and straighten your working leg."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "伸展并拉直动作腿。"
          }
        }
      }
    },
    "feedback.a-la-seconde-working-knee-bent.medium": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your working knee appears slightly bent; lengthen through the leg."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "伸展并拉直动作腿（根据当前照片判断）。"
          }
        }
      }
    },
    "feedback.a-la-seconde-working-leg-not-side.high": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Move your working leg outward into the side plane without forcing it lower."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让动作腿向侧面延伸，不必强行压低。"
          }
        }
      }
    },
    "feedback.a-la-seconde-working-leg-not-side.medium": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your working leg may be drifting away from the side plane; guide it slightly outward."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让动作腿向侧面延伸，不必强行压低（根据当前照片判断）。"
          }
        }
      }
    },
    "feedback.arabesque-lower-leg-for-pelvis.high": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower your working leg slightly and re-level your pelvis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍微放低动作腿，并让骨盆重新保持水平。"
          }
        }
      }
    },
    "feedback.arabesque-lower-leg-for-pelvis.medium": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pelvis may be lifting with the leg; lower the leg slightly and re-level it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍微放低动作腿，并让骨盆重新保持水平（根据当前照片判断）。"
          }
        }
      }
    },
    "feedback.arabesque-torso-collapse.high": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lengthen your torso forward and upward."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让躯干向前上方延伸。"
          }
        }
      }
    },
    "feedback.arabesque-torso-collapse.medium": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your torso appears compressed; lengthen forward and upward."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让躯干向前上方延伸（根据当前照片判断）。"
          }
        }
      }
    },
    "feedback.arabesque-working-knee-bent.high": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lengthen and straighten your working leg."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "伸展并拉直动作腿。"
          }
        }
      }
    },
    "feedback.arabesque-working-knee-bent.medium": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your working knee appears slightly bent; lengthen through the leg."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "伸展并拉直动作腿（根据当前照片判断）。"
          }
        }
      }
    },
    "feedback.arabesque-working-leg-too-low.high": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lengthen your working leg back and slightly upward without changing your pelvis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持骨盆稳定，将动作腿向后上方延伸。"
          }
        }
      }
    },
    "feedback.arabesque-working-leg-too-low.medium": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your working leg may be dropping; reach it back and slightly upward while keeping the pelvis level."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持骨盆稳定，将动作腿向后上方延伸（根据当前照片判断）。"
          }
        }
      }
    },
    "feedback.attitude-level-pelvis.high": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lower your working leg slightly and level your pelvis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍微放低动作腿，保持骨盆水平。"
          }
        }
      }
    },
    "feedback.attitude-level-pelvis.medium": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your pelvis may be lifting with the thigh; lower the leg slightly and re-level it."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍微放低动作腿，保持骨盆水平（根据当前照片判断）。"
          }
        }
      }
    },
    "feedback.attitude-lift-thigh.high": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lift your working thigh slightly while keeping your pelvis level."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持骨盆稳定，将动作大腿稍微抬高。"
          }
        }
      }
    },
    "feedback.attitude-lift-thigh.medium": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your working thigh appears low; lift it slightly without changing the pelvis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "保持骨盆稳定，将动作大腿稍微抬高（根据当前照片判断）。"
          }
        }
      }
    },
    "feedback.attitude-working-knee-too-closed.high": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open the angle behind your working knee slightly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍微打开动作膝后方的角度。"
          }
        }
      }
    },
    "feedback.attitude-working-knee-too-closed.medium": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The angle behind your working knee may be too closed; open it slightly."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍微打开动作膝后方的角度（根据当前照片判断）。"
          }
        }
      }
    },
    "feedback.attitude-working-knee-too-straight.high": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Soften your working knee into a clearer attitude shape."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍微弯曲动作膝，形成更清晰的 attitude 形态。"
          }
        }
      }
    },
    "feedback.attitude-working-knee-too-straight.medium": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your working knee appears nearly straight; soften it into the attitude shape."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "稍微弯曲动作膝，形成更清晰的 attitude 形态（根据当前照片判断）。"
          }
        }
      }
    },
    "feedback.head-extreme-lateral-tilt.high": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your head closer to the line of your torso."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让头部更接近躯干的延长线。"
          }
        }
      }
    },
    "feedback.head-extreme-lateral-tilt.medium": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your head appears strongly tilted; bring it slightly closer to your torso line."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让头部更接近躯干的延长线（根据当前照片判断）。"
          }
        }
      }
    },
    "feedback.left-arm-line-collapsed.high": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lengthen through your left elbow to restore the arm line."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "伸展左肘，恢复手臂线条。"
          }
        }
      }
    },
    "feedback.left-arm-line-collapsed.medium": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your left elbow appears compressed; lengthen gently through the arm."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "伸展左肘，恢复手臂线条（根据当前照片判断）。"
          }
        }
      }
    },
    "feedback.pelvis-unlevel.high": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From this view, level the visible line of your pelvis."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从这个角度看，请让骨盆保持水平。"
          }
        }
      }
    },
    "feedback.pelvis-unlevel.medium": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From this view, your pelvis may appear uneven."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从这个角度看，请让骨盆保持水平（根据当前照片判断）。"
          }
        }
      }
    },
    "feedback.retire-open-working-knee.high": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From this front view, move your visible working knee slightly farther to the side."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从正面看，让动作膝稍微向外打开。"
          }
        }
      }
    },
    "feedback.retire-open-working-knee.medium": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "From this front view, your working knee may appear close to the standing side."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "从正面看，让动作膝稍微向外打开（根据当前照片判断）。"
          }
        }
      }
    },
    "feedback.retire-place-foot-at-knee.high": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Bring your working foot closer to the supporting knee."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让动作脚更靠近支撑腿膝盖。"
          }
        }
      }
    },
    "feedback.retire-place-foot-at-knee.medium": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your working foot appears away from the supporting knee; bring it closer."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "让动作脚更靠近支撑腿膝盖（根据当前照片判断）。"
          }
        }
      }
    },
    "feedback.right-arm-line-collapsed.high": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lengthen through your right elbow to restore the arm line."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "伸展右肘，恢复手臂线条。"
          }
        }
      }
    },
    "feedback.right-arm-line-collapsed.medium": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
